# ========================================================================
# Mastermind 智囊团 · 环境变量示例
#
# 本地开发：复制此文件为 .env.local（已被 .gitignore 排除），填入真实值
# 生产环境（网页）：在 Vercel Dashboard → Settings → Environment Variables 配置
# 生产环境（飞书 worker）：在 Railway Dashboard → Project → Variables 配置
#                          需要全部 11 个变量；.env.worker 本地副本同名同值
# ========================================================================

# ---- DashScope (Qwen) API 配置 ----

# 阿里云百炼 API Base URL（OpenAI 兼容模式）
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# 阿里云 API Key（格式形如 sk-xxxxxxxx...）
# 获取地址: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=""

# ---- 模型选择 ----
#
# 2026-08-07 与 ai-news-radar 共用账号实测可用：
#   deepseek-v4-flash-0731     ⭐ 主力；关闭 thinking 后长摘要与生产调用通过
#   qwen3.8-max                · 短任务稳定，长任务可能超时，适合作备用
#   glm-5.2                    ⚠️ HTTP 200 空正文率较高，暂不放默认链
#   qwen3.5-ocr                · OCR 专用，不能用于圆桌文本生成
#
# 历史（额度已尽，仅留档）：qwen3.6-max-preview（07-20 到期）、
# qwen3.5-plus 系（05-18 到期）、deepseek-v4-pro（07-24 到期）
#
# ⚠️  Qwen 3.x 默认开启 reasoning（thinking）阶段，会先吐 ~30s thinking 才出 content。
#     api/council.ts + api/intake-clarify.ts 已传 `enable_thinking: false` 关闭，
#     使响应在 Vercel edge 60s maxDuration 内完成。
#
# ⚠️  `qwen3-max` / `qwen3-max-preview` / `qwen-plus` / `qwen-max` / `qwen-turbo`
#     这些"传统系列"在 2026-04-29 已被实测确认免费额度全部耗尽（"仅免费额度"模式下 403）。
#     若账户开启"仅免费额度"保护：到 https://bailian.console.aliyun.com/
#     关闭"免费额度用完即停"开关可切按量付费；或换用上面 ⭐ 列表里的新模型。
#
# 服务端选哪个 model 由这三个 env 变量决定（council 用 SYNTHESIZER）：

# 军师圆桌用（council 单次调用同时演 N 位人物 + 输出结构化 JSON，质量瓶颈）
MODEL_SYNTHESIZER="deepseek-v4-flash-0731"

# 军师发言用（当前 council 架构没用，留作将来切回 N 次调用时的预留）
MODEL_ADVISOR="deepseek-v4-flash-0731"

# 主持人追问用（MVP 已 bypass，但 intake-clarify 仍走此模型，可换轻量）
MODEL_HOST="deepseek-v4-flash-0731"

# ---- 自愈兜底链（Fallback Chain）----
#
# 当首选模型（MODEL_SYNTHESIZER / MODEL_HOST）返回 quota 错、调用超时或
# HTTP 200 但正文为空时，api/_shared/llm-chain.ts 会自动切到下一个模型。
# 机制：
#
#   - 顺序：首选模型 → LLM_MODEL_CHAIN 列出的备选（逗号分隔，按序）
#   - quota 错或空正文切下一个；进程内缓存到次日 UTC 0 点
#   - 其它错（401/404/4xx/5xx）：5xx 指数退避 retry × 3，仍败则冒泡；
#     401/404 直接冒泡（不假装能自愈一个真坏掉的 key 或不存在的模型）
#   - 60s per-model 调用超时；超时切下一个
#
# ⚠️ 本链没有 ai-news-radar 那种 Supabase 自动
# discovery，新模型必须手动登记——阿里免费额度按模型 ID 单独计且一次性
# 不重置，池子会持续缩小，耗尽前需决策：换新免费模型 / 换厂商 / 付费。
LLM_MODEL_CHAIN="qwen3.8-max"

# ========================================================================
# ---- 飞书长连接 worker 专用变量（仅 scripts/feishu-worker.ts 用）----
# ========================================================================
#
# Worker 进程从飞书 Open Platform 通过 WebSocket 长连接接收 im.message.receive_v1
# 事件，运行在 Railway/Fly.io 等 7×24 长连接友好的云端（不是 Vercel）。
#
# 飞书自建应用凭证：开发者后台 → 应用管理 → 凭证与基础信息
# https://open.feishu.cn/app
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""

# 共享 KV（Upstash Redis REST），存军师选择 pending 状态 + 完整讨论 share
# Vercel Dashboard → Storage → Upstash 接入，会自动注入这 2 个变量；
# Railway 端需要手动从 Upstash console 复制对应值。
# https://console.upstash.com/redis
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# 飞书卡片「看完整讨论」按钮跳转到的网页 base URL
# 默认 https://mastermind-gamma-weld.vercel.app（线上 prod）；本地开发可改 http://localhost:3000
PUBLIC_BASE_URL="https://mastermind-gamma-weld.vercel.app"
